  {
   "cell_type": "markdown",
   "id": "6b2df764",
   "metadata": {},
   "source": [
    "## Angular height log-ratio"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "bc76af64",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "wrote /Users/jnaiman/Dropbox/WASP2026/paper_figures/angular_height_logratio.pdf\n",
      "\n",
      "log-ratio summary (non-positive predictions cannot be logged and are excluded, counted separately from unparseable):\n",
      "          run  model  answers  unparseable  non-positive  plotted  median dex  over %  under %  within 2x %  within 10x %  >+1 dex %  <-1 dex %\n",
      "     original    GPT      170            2             0      168        1.19   88.69    11.31        16.07         47.02      52.98       0.00\n",
      "     original Gemini      170            0             0      170       -0.05   27.06    72.94        94.71         99.41       0.59       0.00\n",
      "     original Claude      170            0             0      170       -0.07   44.71    55.29        38.82         65.88      32.35       1.76\n",
      "archive-light    GPT      170            4             1      165        1.28   87.27    12.73        15.76         40.00      60.00       0.00\n",
      "archive-light Gemini      170            0             0      170       -0.04   28.82    71.18        94.71         98.24       1.76       0.00\n",
      "archive-light Claude      170            0             0      170       -0.06   43.53    56.47        40.00         66.47      32.35       1.18\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 680x350 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ============== ANGULAR HEIGHT: log-ratio instead of sSMAPE ==============\n",
    "# Why this question gets a second metric.\n",
    "#\n",
    "# sSMAPE is bounded at +/-2.  That is a virtue for the colour questions -- it\n",
    "# keeps a near-zero ground truth from blowing the score up -- but a liability\n",
    "# here: the angular ground truth spans five decades (0.02 .. 1770 arcmin on the\n",
    "# n150 run) and the models are wrong by more than 10x on most answers, so the\n",
    "# scores pile up against the bound.  Measured on that run, half the answers sit\n",
    "# beyond |sSMAPE| = 1.8 and a quarter are pinned past 1.95, which makes a\n",
    "# prediction 12x too large indistinguishable from one 80,000x too large.\n",
    "#\n",
    "# log10(LMM/GT) does not saturate, and it is symmetric in multiplicative terms:\n",
    "# 2x too large is +0.30 dex, 2x too small is -0.30 dex.  Plain relative error,\n",
    "# (GT - LMM)/GT, is NOT symmetric -- bounded at 1 for any undershoot but\n",
    "# unbounded for overshoot, so the same 10x error scores +0.90 or -9.00 purely\n",
    "# by direction, and the mean is then dominated by a handful of overshoots.\n",
    "#\n",
    "# It is defined only where both values are positive.  That exclusion is counted\n",
    "# and printed below rather than left implicit.\n",
    "\n",
    "#logratio_xlim      = (-5.0, 5.0)   # dex; the n150 run spans about -2.2 .. +4.9\n",
    "logratio_xlim      = (-4.0, 4.0)   # dex; the n150 run spans about -2.2 .. +4.9\n",
    "logratio_nbins     = 20\n",
    "show_factor_guides = True          # light marks at a factor of ten either way\n",
    "factor_guides      = (-1.0, 1.0)   # where those marks sit, in dex\n",
    "\n",
    "# Arrows naming which direction is which.  Placed in the space OUTSIDE the\n",
    "# factor guides, with positions read from `factor_guides` and `logratio_xlim`,\n",
    "# so moving a guide or widening the axis moves them too rather than leaving\n",
    "# them stranded on top of a line.\n",
    "show_direction_arrows = True\n",
    "arrow_row        = 0       # which run row carries them (0 = top)\n",
    "arrow_y_frac     = 0.82    # height within the panel, in axes fractions\n",
    "arrow_headroom   = 1.35    # y-limit padding so they clear the tallest bar\n",
    "arrow_color      = '0.35'\n",
    "arrow_fontsize   = 13\n",
    "\n",
    "# Nudge the arrows AND their labels up or down together, in axes fractions.\n",
    "# NEGATIVE moves them DOWN -- e.g. -0.05 drops the pair by 5% of the panel\n",
    "# height.  This is the knob to reach for; `arrow_y_frac` above is the nominal\n",
    "# height and is better left where it is so the two figures stay comparable.\n",
    "# The arrow and its text move as one, so the label never lands on the arrow.\n",
    "arrow_y_nudge    = -0.025\n",
    "\n",
    "# The other two spacings, which used to share a single `facpad` and so could\n",
    "# not be set independently -- raising it to lift the label also shortened both\n",
    "# arrows.  They are different axes and different units, hence two names:\n",
    "arrow_xpad_frac  = 0.05    # HORIZONTAL clearance at each end of an arrow, as a\n",
    "                           # fraction of the x-range: keeps it off the factor\n",
    "                           # guide at one end and the frame at the other\n",
    "arrow_label_gap  = 0.04    # VERTICAL gap between an arrow and its text, in\n",
    "                           # axes fractions\n",
    "\n",
    "row_height_in = 1.75     # height of one row\n",
    "\n",
    "\n",
    "\n",
    "def logratio(lmm, gt):\n",
    "    \"\"\"log10(LMM / GT); NaN where either value is missing or non-positive.\"\"\"\n",
    "    lmm = np.asarray(lmm, dtype=float)\n",
    "    gt  = np.asarray(gt,  dtype=float)\n",
    "    out = np.full(lmm.shape, np.nan)\n",
    "    ok = np.isfinite(lmm) & np.isfinite(gt) & (lmm > 0) & (gt > 0)\n",
    "    out[ok] = np.log10(lmm[ok] / gt[ok])\n",
    "    return out\n",
    "\n",
    "\n",
    "dfmean['logratio'] = logratio(dfmean['LMM'].values, dfmean['GT'].values)\n",
    "\n",
    "\n",
    "def _draw_direction_arrows(ax):\n",
    "    \"\"\"\n",
    "    \"under estimate\" / \"over estimate\" arrows, in the clear space beyond the\n",
    "    factor guides.\n",
    "\n",
    "    Positions come from `factor_guides` and `logratio_xlim` rather than being\n",
    "    hard-coded, so they follow the guides if either is changed.  x is in data\n",
    "    units and y in axes fractions (get_xaxis_transform), so the height is\n",
    "    stable whatever the counts do.  If a side has no room -- a guide pushed out\n",
    "    to the edge, or a narrow axis -- that arrow is skipped rather than drawn\n",
    "    across the line it exists to avoid.\n",
    "    \"\"\"\n",
    "    tr = ax.get_xaxis_transform()\n",
    "    lo, hi = logratio_xlim\n",
    "    if show_factor_guides and factor_guides:\n",
    "        g_lo, g_hi = min(factor_guides), max(factor_guides)\n",
    "    else:\n",
    "        g_lo = g_hi = 0.0\n",
    "    pad = arrow_xpad_frac * (hi - lo)   # clear of the guide and of the frame\n",
    "    y = arrow_y_frac + arrow_y_nudge    # one height for arrow and label both\n",
    "\n",
    "    for start, end, label in ((g_lo - pad, lo + pad, 'under estimate'),\n",
    "                              (g_hi + pad, hi - pad, 'over estimate')):\n",
    "        if abs(end - start) < 0.15 * (hi - lo):\n",
    "            continue                # not enough room; better absent than cramped\n",
    "        ax.annotate('', xy=(end, y), xytext=(start, y),\n",
    "                    xycoords=tr, textcoords=tr, zorder=6,\n",
    "                    arrowprops=dict(arrowstyle='-|>', color=arrow_color,\n",
    "                                    lw=1.6, shrinkA=0, shrinkB=0))\n",
    "        ax.text((start + end) / 2.0, y + arrow_label_gap, label, transform=tr,\n",
    "                ha='center', va='bottom', fontsize=arrow_fontsize,\n",
    "                color=arrow_color)\n",
    "\n",
    "\n",
    "def plot_question_logratio(qlabel, show_legend=True, ylim_in=None):\n",
    "    \"\"\"\n",
    "    plot_question(), but on log10(LMM/GT).\n",
    "\n",
    "    Same layout deliberately: a row per run, packed tight, x-axis label and\n",
    "    tick labels only on the bottom row, so this figure can sit beside the\n",
    "    sSMAPE one and be read the same way.\n",
    "    \"\"\"\n",
    "    entry = next(q for q in questions if q[0] == qlabel)\n",
    "    _, _, qaxis, out_file = entry\n",
    "    out_file = out_file.replace('_ssmape', '_logratio')\n",
    "    nrows = len(row_labels)\n",
    "    bins_lr = np.linspace(logratio_xlim[0], logratio_xlim[1], logratio_nbins)\n",
    "\n",
    "    # One y-range for every row, so the runs are read on the same scale --\n",
    "    # same reason the two sSMAPE angular figures share theirs.  The arrow\n",
    "    # headroom goes on ALL rows, not just the one carrying the arrows: applied\n",
    "    # to that row alone it shrinks its bars relative to the rows below and\n",
    "    # reintroduces exactly the mismatch it is sharing the axis to avoid.\n",
    "    if ylim_in is None:\n",
    "        lr_ylim = ylim\n",
    "    else:\n",
    "        lr_ylim = ylim_in\n",
    "    if lr_ylim is None:\n",
    "        _top = _hist_ymax([qlabel], bins_lr, column='logratio')\n",
    "        if _top > 0:\n",
    "            lr_ylim = (0.0, _top * y_headroom *\n",
    "                       (arrow_headroom if show_direction_arrows else 1.0))\n",
    "\n",
    "    fig, axes = plt.subplots(nrows, 1, sharex=True,\n",
    "                             figsize=(fig_width_in, row_height_in * nrows),\n",
    "                             gridspec_kw={'hspace': row_gap})\n",
    "    axes = np.atleast_1d(axes)\n",
    "\n",
    "    for i, (ax, rlab) in enumerate(zip(axes, row_labels)):\n",
    "        last = (i == nrows - 1)\n",
    "        sel = dfmean[(dfmean['question'] == qlabel) & (dfmean['run'] == rlab)]\n",
    "        for mdir, (mname, color) in model_spec.items():\n",
    "            vals = sel.loc[sel['model'] == mname, 'logratio'].values\n",
    "            vals = vals[np.isfinite(vals)]\n",
    "            if len(vals) == 0:\n",
    "                continue\n",
    "            ax.hist(vals, bins=bins_lr, density=True, label=mname,\n",
    "                    color=color, edgecolor=color, linewidth=hist_thick,\n",
    "                    histtype='step')\n",
    "        if show_factor_guides:\n",
    "            # a factor of 10 either way, for reading the axis at a glance\n",
    "            for g in factor_guides:\n",
    "                ax.axvline(g, color='0.8', linestyle=':', linewidth=1.5, zorder=0)\n",
    "        if show_zero_line:\n",
    "            ax.axvline(0.0, color='gray', linestyle='--', linewidth=2, zorder=0)\n",
    "        ax.set_xlim(logratio_xlim)\n",
    "        if lr_ylim is not None:\n",
    "            # arrow_headroom is already folded in above, so the arrows clear\n",
    "            # the tallest bar of any row rather than sitting across it\n",
    "            ax.set_ylim(lr_ylim)\n",
    "\n",
    "        if show_direction_arrows and i == arrow_row:\n",
    "            _draw_direction_arrows(ax)\n",
    "        ax.set_ylabel(rlab, fontsize=rowlabel_fontsize)\n",
    "        ax.tick_params(axis='both', which='major', labelsize=tick_fontsize)\n",
    "        if last:\n",
    "            ax.set_xlabel(r'$\\log_{10}(\\mathrm{LMM}/\\mathrm{GT})$  [dex]',\n",
    "                          fontsize=fontsize)\n",
    "        else:\n",
    "            ax.set_xlabel('')\n",
    "            plt.setp(ax.get_xticklabels(), visible=False)\n",
    "            ax.tick_params(axis='x', length=0)\n",
    "\n",
    "    ttl = '%s   %s' % (qlabel, qaxis)\n",
    "    if only_category is not None:\n",
    "        ttl += '  (%s)' % only_category\n",
    "    axes[0].set_title(ttl, fontsize=fontsize)\n",
    "\n",
    "    if show_legend:\n",
    "        lax = _legend_ax(axes)\n",
    "        if legend_inside:\n",
    "            lax.legend(loc=legend_loc, fontsize=legend_fontsize,\n",
    "                       frameon=True, framealpha=legend_framealpha,\n",
    "                       edgecolor='0.6')\n",
    "        else:\n",
    "            lax.legend(loc='center left', bbox_to_anchor=(1.02, 0.5),\n",
    "                       fontsize=legend_fontsize, frameon=False)\n",
    "\n",
    "    out_path = os.path.join(fig_out_dir, out_file)\n",
    "    fig.savefig(out_path, bbox_inches='tight')\n",
    "    print('wrote', out_path)\n",
    "\n",
    "    # What the histogram leaves out, and the interpretable companion numbers.\n",
    "    # \"within a factor of k\" needs no explanation in a caption, and unlike a\n",
    "    # mean it is unaffected by the extreme overshoots.\n",
    "    sel = dfmean[dfmean['question'] == qlabel]\n",
    "    recs = []\n",
    "    for rlab in row_labels:\n",
    "        for mdir, (mname, _) in model_spec.items():\n",
    "            s = sel[(sel['run'] == rlab) & (sel['model'] == mname)]\n",
    "            if len(s) == 0:\n",
    "                continue\n",
    "            lr = s['logratio'].values\n",
    "            good = np.isfinite(lr)\n",
    "            # over/under split: log10(LMM/GT) is positive when the model\n",
    "            # answered too LARGE.  Reported because the median alone hides a\n",
    "            # one-sided bias -- a model can sit near zero on average while\n",
    "            # overshooting on almost every figure.  The two sum to 100 minus\n",
    "            # any exact ties, which floats make vanishingly rare.\n",
    "            over = 100.0 * np.mean(lr[good] > 0) if good.any() else np.nan\n",
    "            under = 100.0 * np.mean(lr[good] < 0) if good.any() else np.nan\n",
    "            recs.append({\n",
    "                'run': rlab, 'model': mname,\n",
    "                'answers': len(s),\n",
    "                'unparseable': int(s['LMM'].isna().sum()),\n",
    "                'non-positive': int((~good).sum() - s['LMM'].isna().sum()),\n",
    "                'plotted': int(good.sum()),\n",
    "                'median dex': np.median(lr[good]) if good.any() else np.nan,\n",
    "                'over %': over,\n",
    "                'under %': under,\n",
    "                'within 2x %': 100.0 * np.mean(np.abs(lr[good]) < np.log10(2)) if good.any() else np.nan,\n",
    "                'within 10x %': 100.0 * np.mean(np.abs(lr[good]) < 1.0) if good.any() else np.nan,\n",
    "                # the far tails, split by direction.  'over %' counts any\n",
    "                # overshoot however small; these count only the ones past a\n",
    "                # factor of ten, which is where an answer stops being a\n",
    "                # mis-estimate and becomes the wrong quantity entirely.\n",
    "                # The three 10x columns partition the answers:\n",
    "                #   >+1 dex  +  within 10x  +  <-1 dex  =  100\n",
    "                '>+1 dex %': 100.0 * np.mean(lr[good] > 1.0) if good.any() else np.nan,\n",
    "                '<-1 dex %': 100.0 * np.mean(lr[good] < -1.0) if good.any() else np.nan,\n",
    "            })\n",
    "    print()\n",
    "    print('log-ratio summary (non-positive predictions cannot be logged and are '\n",
    "          'excluded, counted separately from unparseable):')\n",
    "    print(pd.DataFrame(recs).to_string(index=False,\n",
    "                                       float_format=lambda v: '%.2f' % v))\n",
    "    return fig\n",
    "\n",
    "\n",
    "fig_height_logratio = plot_question_logratio('angular height', ylim_in = (0,2.3))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "87db15da",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "9dedfc9e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============ WHY: the models' own explanations, by error band ============\n",
    "# The four sections below all ask the same question of the angular-height\n",
    "# log-ratio: pull a handful of answers out of one band of that distribution and\n",
    "# print what the model SAID it was doing.  The machinery sits here, once; each\n",
    "# section below is a single call naming its band.\n",
    "#\n",
    "# Where the text comes from: every prompt asked for a second JSON snippet,\n",
    "# {\"explanation\":\"\"}, alongside the answer JSON, and both are saved verbatim in\n",
    "# the run pickles ('raw answer').  parse_llm_dual_json separates the two, so\n",
    "# these quotes come out of exactly the same tolerant parse that produced the\n",
    "# histograms -- an answer that was unparseable above cannot be quoted here\n",
    "# under a dex value it never had.\n",
    "#\n",
    "# Only the sampled rows are re-opened (n per model, not the whole run), so this\n",
    "# is a handful of pickle reads rather than another pass over the directory.\n",
    "\n",
    "import textwrap\n",
    "from utils.parse_lmm_output_utils import parse_llm_dual_json\n",
    "\n",
    "n_explanations       = 3      # how many figures to quote per model\n",
    "explanation_seed     = 0      # fixed -> re-running quotes the same answers.\n",
    "                              # None draws freshly each time.\n",
    "explanation_question = 'angular height'\n",
    "explanation_run      = None   # None -> the first active run ('original')\n",
    "explanation_wrap     = 96     # characters per line when printing\n",
    "explanation_maxchars = None   # truncate a long explanation, or None for all\n",
    "\n",
    "_run_dir  = dict(runs)\n",
    "_mdir_for = {mname: mdir for mdir, (mname, _) in model_spec.items()}\n",
    "_qmatch_for = {q[0]: q[1] for q in questions}\n",
    "\n",
    "# The dex window each section quotes from: band -> (low, high) on\n",
    "# log10(LMM/GT).  Half-open, low <= dex < high, so two windows sharing an edge\n",
    "# cannot both claim the same answer.  Use np.inf / -np.inf for an open end.\n",
    "#\n",
    "# The inner edge is set to +/-0.5 dex (a factor of 3.2) rather than 0, because\n",
    "# the explanation behind a 1.1x error is mostly the model reading the axis\n",
    "# correctly -- true, but not what these sections are for.  Widen it back to\n",
    "# 0.0 to take everything on that side; the four windows then partition every\n",
    "# plotted answer, matching the '>+1 dex %' / 'within 10x %' / '<-1 dex %'\n",
    "# columns of the summary table above.\n",
    "#\n",
    "# Any window can also be overridden for one call without editing this:\n",
    "#     show_explanations('over-within', window=(0.3, 0.8))\n",
    "explanation_bands = {\n",
    "    'over-within':  ( 0.5,  1.0),      # too large, inside a factor of 10\n",
    "    'over-beyond':  ( 1.0,  np.inf),   # too large by more than a factor of 10\n",
    "    'under-within': (-1.0, -0.5),      # too small, inside a factor of 10\n",
    "    'under-beyond': (-np.inf, -1.0),   # too small by more than a factor of 10\n",
    "}\n",
    "\n",
    "\n",
    "def _band_heading(lo, hi):\n",
    "    \"\"\"\n",
    "    'OVER-estimates   +0.50 <= dex < +1.00   (3.2x to 10x too large)'\n",
    "\n",
    "    Built from the window itself rather than stored beside it, so an edited\n",
    "    window cannot end up printed under a heading describing the old one.\n",
    "    \"\"\"\n",
    "    if hi <= 0:\n",
    "        side, word = 'UNDER-estimates', 'too small'\n",
    "    elif lo >= 0:\n",
    "        side, word = 'OVER-estimates ', 'too large'\n",
    "    else:\n",
    "        side, word = 'BOTH directions', 'off'\n",
    "    if np.isinf(lo):\n",
    "        rng, fac = 'dex < %+.2f' % hi, 'more than %.3gx %s' % (10 ** abs(hi), word)\n",
    "    elif np.isinf(hi):\n",
    "        rng, fac = 'dex >= %+.2f' % lo, 'more than %.3gx %s' % (10 ** abs(lo), word)\n",
    "    else:\n",
    "        rng = '%+.2f <= dex < %+.2f' % (lo, hi)\n",
    "        fac = '%.3gx to %.3gx %s' % (10 ** min(abs(lo), abs(hi)),\n",
    "                                     10 ** max(abs(lo), abs(hi)), word)\n",
    "    return '%s   %s   (%s)' % (side, rng, fac)\n",
    "\n",
    "\n",
    "def explanation_for(entry):\n",
    "    \"\"\"The model's {\"explanation\": ...} text for one pickle entry, or None.\"\"\"\n",
    "    _, expl = parse_llm_dual_json(\n",
    "        entry.get('raw answer') or entry.get('Response') or '')\n",
    "    if not expl:\n",
    "        return None\n",
    "    for k in ('explanation', 'reason', 'reasoning', 'rationale'):\n",
    "        if k in expl:\n",
    "            v = expl[k]\n",
    "            return v if isinstance(v, str) else json.dumps(v)\n",
    "    return None\n",
    "\n",
    "\n",
    "def _entry_for(run_label, model, vqa_id, qmatch):\n",
    "    \"\"\"Re-open the one pickle a sampled row came from, and find its entry.\"\"\"\n",
    "    fp = os.path.join(os.path.expanduser(_run_dir[run_label]),\n",
    "                      _mdir_for[model], vqa_id + '_qa.pickle')\n",
    "    with open(fp, 'rb') as f:\n",
    "        payload = pickle.load(f)\n",
    "    qa_list = payload[0] if isinstance(payload, (list, tuple)) else payload\n",
    "    for e in qa_list:\n",
    "        q = (e.get('question') or '').lower()\n",
    "        if all(m in q for m in qmatch):\n",
    "            return e\n",
    "    return None\n",
    "\n",
    "\n",
    "def show_explanations(band, n=None, run=None, question=None, seed=0,\n",
    "                      window=None):\n",
    "    \"\"\"\n",
    "    Quote `n` randomly chosen explanations per model from one dex window.\n",
    "\n",
    "    band   : key of `explanation_bands`, which supplies the window and names\n",
    "             the section in the returned frame.\n",
    "    window : (low, high) in dex, overriding that band's window for this call\n",
    "             only -- e.g. window=(0.5, 1.0) for answers 3.2x to 10x too large.\n",
    "             Half-open: low <= dex < high.\n",
    "    n      : figures per model; defaults to `n_explanations`.\n",
    "    seed   : offset added to `explanation_seed`, so the four sections draw\n",
    "             independently but each one reproducibly.\n",
    "\n",
    "    Returns the sampled rows (with their explanations) as a DataFrame, so a\n",
    "    quote can be lifted into the paper without re-running the print.\n",
    "    \"\"\"\n",
    "    n = n_explanations if n is None else n\n",
    "    run = (explanation_run or active_runs[0][0]) if run is None else run\n",
    "    question = explanation_question if question is None else question\n",
    "    lo, hi = explanation_bands[band] if window is None else window\n",
    "    if not lo < hi:\n",
    "        raise ValueError('window must be (low, high) with low < high, got '\n",
    "                         '(%r, %r)' % (lo, hi))\n",
    "    qmatch = _qmatch_for[question]\n",
    "\n",
    "    rng = np.random.default_rng(None if explanation_seed is None\n",
    "                                else explanation_seed + seed)\n",
    "\n",
    "    print('=' * 78)\n",
    "    print('%s' % _band_heading(lo, hi))\n",
    "    print('%s, %s run' % (question, run))\n",
    "    print('=' * 78)\n",
    "\n",
    "    picked = []\n",
    "    for mdir, (mname, _) in model_spec.items():\n",
    "        sel = dfmean[(dfmean['question'] == question) &\n",
    "                     (dfmean['run'] == run) &\n",
    "                     (dfmean['model'] == mname)]\n",
    "        lr = sel['logratio'].values\n",
    "        plotted = int(np.isfinite(lr).sum())\n",
    "        # NaN compares False both ways, so non-finite rows (unparseable, or\n",
    "        # a non-positive prediction that cannot be logged) drop out on their\n",
    "        # own rather than needing a separate isfinite().\n",
    "        in_band = sel[(lr >= lo) & (lr < hi)]\n",
    "\n",
    "        print()\n",
    "        print('-' * 78)\n",
    "        print('%s: %d of %d plotted answers in this window (%.0f%%)'\n",
    "              % (mname, len(in_band), plotted,\n",
    "                 100.0 * len(in_band) / plotted if plotted else np.nan))\n",
    "        print('-' * 78)\n",
    "        if len(in_band) == 0:\n",
    "            print('  (nothing to quote)')\n",
    "            continue\n",
    "\n",
    "        take = min(n, len(in_band))\n",
    "        if take < n:\n",
    "            print('  (only %d available; quoting all of them)' % take)\n",
    "        idx = rng.choice(len(in_band), size=take, replace=False)\n",
    "        for row in in_band.iloc[np.sort(idx)].itertuples():\n",
    "            entry = _entry_for(run, mname, row.vqa_id, qmatch)\n",
    "            text = explanation_for(entry) if entry is not None else None\n",
    "            if text is None:\n",
    "                text = '(no explanation JSON came back)'\n",
    "            elif explanation_maxchars and len(text) > explanation_maxchars:\n",
    "                text = text[:explanation_maxchars].rstrip() + ' ...'\n",
    "            print()\n",
    "            print('  %s  [%s]' % (row.vqa_id, row.category))\n",
    "            print('    GT %.4g   LMM %.4g   -> %+.2f dex (%s %.1fx)'\n",
    "                  % (row.GT, row.LMM, row.logratio,\n",
    "                     'over by' if row.logratio > 0 else 'under by',\n",
    "                     10 ** abs(row.logratio)))\n",
    "            print(textwrap.fill(text, width=explanation_wrap,\n",
    "                                initial_indent='    ', subsequent_indent='    '))\n",
    "            picked.append({'band': band, 'dex_low': lo, 'dex_high': hi,\n",
    "                           'run': run, 'model': mname,\n",
    "                           'vqa_id': row.vqa_id, 'category': row.category,\n",
    "                           'GT': row.GT, 'LMM': row.LMM, 'dex': row.logratio,\n",
    "                           'explanation': text})\n",
    "    print()\n",
    "    return pd.DataFrame(picked)"
   ]
  },
  {
